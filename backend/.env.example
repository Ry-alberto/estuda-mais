# Back-end environment variables. Copy to .env to run the API outside Docker:
#   cp .env.example .env
# In production (Render/Railway) set these in the provider's dashboard instead.

# PostgreSQL connection (docker compose exposes the database on localhost:5432).
DATABASE_URL=postgresql://estuda:estuda@localhost:5432/estuda_mais?schema=public

# Secret used to sign JWTs. At least 16 characters; use a long random value in Prod
# (e.g. `openssl rand -base64 48`).
JWT_SECRET=troque-este-segredo-de-desenvolvimento
JWT_EXPIRES_IN_SECONDS=86400

PORT=3000
# Front-end origins allowed by CORS, comma-separated.
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
