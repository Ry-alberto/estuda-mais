# Variables for docker compose (Dev environment, section 9 of the project document).
#   cp .env.example .env && docker compose up --build
# The .env file is git-ignored; never commit real secrets.

POSTGRES_USER=estuda
POSTGRES_PASSWORD=estuda
POSTGRES_DB=estuda_mais

# At least 16 characters. Generate a real one with: openssl rand -base64 48
JWT_SECRET=troque-este-segredo-de-desenvolvimento
JWT_EXPIRES_IN_SECONDS=86400

# Host ports
API_PORT=3000
WEB_PORT=8080

# URL the browser uses to reach the API (baked into the front-end build).
VITE_API_URL=http://localhost:3000
